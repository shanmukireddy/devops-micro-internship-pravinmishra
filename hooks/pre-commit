#!/bin/bash

# Pre-commit hook to block secret leaks and oversized files (>1MB)

# 1. Check for files larger than 1MB (1048576 bytes)
MAX_SIZE=1048576
for file in $(git diff --cached --name-only); do
    if [ -f "$file" ]; then
        FILE_SIZE=$(wc -c < "$file")
        if [ "$FILE_SIZE" -gt "$MAX_SIZE" ]; then
            echo "BLOCKED: File $file is larger than 1MB ($FILE_SIZE bytes)."
            exit 1
        fi
    fi
done

# 2. Check for secret patterns (e.g., AWS Access Keys starting with AKIA)
SECRET_PATTERN="AKIA[0-9A-Z]{16}"
for file in $(git diff --cached --name-only); do
    if [ -f "$file" ]; then
        if grep -E -q "$SECRET_PATTERN" "$file"; then
            echo "BLOCKED: Potential secret detected in $file"
            exit 1
        fi
    fi
done

exit 0
